CompileFlags:
  CompilationDatabase: build
  Compiler: /software/Applications/gcc/13.3.0/bin/c++
  Remove:
    - -Winvalid-pch
    - -include

---
If:
  PathMatch: .*src/gpu/.*\.(cu|cuh|h|hpp)
CompileFlags:
  Compiler: clang++
  Remove:
    - -forward-unknown-to-host-compiler
    - -gencode
    - "arch=compute_*,code=sm_*"
    - -Xcudafe
    - "--diag_suppress=*"
    - --expt-relaxed-constexpr
    - --expt-extended-lambda
    - "-Xcompiler=*"
    - -x
  Add:
    - -xcuda
    - --cuda-path=/usr/local/cuda
    - --cuda-gpu-arch=sm_89
    - -Wno-unknown-cuda-version
