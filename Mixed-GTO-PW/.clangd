CompileFlags:
  Add:
    - "-I/usr/lib/gcc/x86_64-linux-gnu/13/include"
    - "-std=c++20"
  CompilationDatabase: build
  Compiler: /software/Applications/gcc/13.3.0/bin/c++
  Remove:
    - -Winvalid-pch

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

---
# This adapter requires the TBLIS dependency flags even in a BLAS workspace.
If:
  PathMatch: src/backend/tblis\.hpp
CompileFlags:
  CompilationDatabase: build/tblis

---
# AO2MO is optional; the default build intentionally has no libcint/CBLAS flags.
If:
  PathMatch: [src/ao2mo\.hpp, src/ao2mo/.*, example/wick_.*\.cpp, unit_test/test_integrals\.cpp, unit_test/test_hdf5\.cpp, test/.*\.(cpp|hpp)]
CompileFlags:
  CompilationDatabase: build/merge-openblas
